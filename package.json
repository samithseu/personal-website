{
  "name": "personal-website",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt cleanup && nuxt build",
    "clean": "nuxt cleanup && rm -rf ./node_modules/.cache",
    "clean:all": "nuxt cleanup && rm -rf ./node_modules/ ./.output ./.vercel",
    "dev": "nuxt cleanup && nuxt dev",
    "dev:host": "nuxt dev --host",
    "generate": "nuxt generate",
    "preview": "NITRO_PRESET=node-server nuxt build && node .output/server/index.mjs",
    "preview:vercel": "vercel deploy --prebuilt",
    "pwa:icons": "node scripts/generate-pwa-icons.mjs",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@nuxt/content": "^3.16.1",
    "@nuxt/fonts": "^0.14.0",
    "@nuxt/icon": "^2.5.1",
    "@nuxt/image": "^2.1.0",
    "@nuxtjs/seo": "5.3.14",
    "@takumi-rs/core": "^2.14.0",
    "@unhead/vue": "^3.4.2",
    "nuxt": "^4.6.0",
    "nuxt-og-image": "6.7.8",
    "ufo": "^1.6.4",
    "unstorage": "^1.17.5",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@iconify-json/tabler": "^1.2.41",
    "@tailwindcss/vite": "^4.3.3",
    "@vite-pwa/nuxt": "^1.1.1",
    "nuxtseo-layer-devtools": "^5.3.16",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3"
  },
  "packageManager": "pnpm@11.28.4+sha512.f905a61563f89b49a292634d3d87d024cfdea9dccf5c66b2ccc261675fa7b2774320a959db472e6caa7f9ff7314709cd50d06c8fd64addb60647377a78d250ff"
}
