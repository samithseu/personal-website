{
  "name": "personal-website",
  "private": true,
  "type": "module",
  "scripts": {
    "sync:projects": "node scripts/sync-projects.mjs",
    "build": "pnpm sync:projects && nuxt cleanup && nuxt build",
    "clean": "nuxt cleanup && rm -rf ./node_modules/.cache",
    "clean:all": "nuxt cleanup && rm -rf ./node_modules/ ./.output ./.vercel",
    "dev": "nuxt cleanup && nuxt dev --no-tui",
    "dev:host": "nuxt dev --host",
    "generate": "pnpm sync:projects && nuxt generate",
    "preview": "NITRO_PRESET=node-server nuxt build && node .output/server/index.mjs",
    "preview:vercel": "vercel deploy --prebuilt",
    "pwa:icons": "node scripts/generate-pwa-icons.mjs",
    "typecheck": "nuxt typecheck",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@nuxt/fonts": "^1.2.0",
    "@nuxtjs/seo": "^6.0.1",
    "@takumi-rs/core": "^2.19.0",
    "nuxt": "^4.6.3",
    "nuxt-og-image": "^7.0.7",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vite-pwa/nuxt": "^1.1.1",
    "nuxtseo-devtools-host": "^1.0.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "vue-tsc": "^3.3.14"
  },
  "packageManager": "pnpm@11.28.9+sha512.35421cea2720eca3f5ad722b67e8ef18f4d3cd4745ed2fcfeb0dc288d4e9437fad3870d91ee6e83f268f0f6f7e0f62723317b19617bb45ee4333172ef51159f8"
}
