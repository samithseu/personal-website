{
  "name": "personal-website",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt cleanup && nuxt build",
    "clean": "nuxt cleanup && rm -rf ./node_modules/.cache",
    "clean:all": "nuxt cleanup && rm -rf ./node_modules/ ./.output ./.vercel",
    "dev": "nuxt cleanup && nuxt dev",
    "dev:host": "nuxt dev --host",
    "generate": "nuxt generate",
    "preview": "NITRO_PRESET=node-server nuxt build && node .output/server/index.mjs",
    "preview:vercel": "vercel deploy --prebuilt",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@nuxt/content": "^3.16.0",
    "@nuxt/fonts": "^0.14.0",
    "@nuxt/icon": "^2.5.1",
    "@nuxt/image": "^2.1.0",
    "@nuxtjs/seo": "^5.3.16",
    "@takumi-rs/core": "^2.14.0",
    "@unhead/vue": "^3.4.1",
    "nuxt": "^4.5.2",
    "nuxt-og-image": "^6.8.0",
    "ufo": "^1.6.4",
    "unstorage": "^1.17.5",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@iconify-json/tabler": "^1.2.39",
    "@tailwindcss/vite": "^4.3.3",
    "nuxtseo-layer-devtools": "^5.3.16",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3"
  },
  "packageManager": "pnpm@11.27.1+sha512.a81d4c21b9b09a4b0aebf90ef5e527d4262bdda322d26082978cb549023ac6d9cafc98b19fffaa5c71db438a65f70224edb78d7311187861ff96480d1cdca23c"
}
